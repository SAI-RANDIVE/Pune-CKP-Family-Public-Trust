# =====================================================================
# Copy to .env.local and fill in. NEVER commit .env.local.
# Anything prefixed NEXT_PUBLIC_ is visible in the browser — only put
# non-secret values there. The Razorpay SECRET must never be public.
# =====================================================================

# --- Neon Postgres ---
# Neon dashboard -> Connection Details -> Pooled connection
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- Razorpay ---
# Dashboard -> Settings -> API Keys. Use rzp_test_* until you go live.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Same value as RAZORPAY_KEY_ID. Safe to expose — it is the publishable key.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# Dashboard -> Settings -> Webhooks. Create a webhook pointing at
#   https://puneckptrust.in/api/razorpay/webhook
# subscribed to: payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# --- Email (Gmail SMTP) ---
# ⚠️ Gmail will NOT accept your normal password. You must create an App Password:
#   1. Enable 2-Step Verification on the Google account
#   2. Visit https://myaccount.google.com/apppasswords
#   3. Generate a 16-character app password and paste it below
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-mailbox@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM_NAME="Pune CKP Family Public Trust"

# --- Security ---
# Random string used to salt OTP hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER="generate-a-long-random-string"

# --- Trust details (public: shown on the site and the receipt) ---
NEXT_PUBLIC_TRUST_NAME="Pune CKP Family Public Trust"
NEXT_PUBLIC_TRUST_REG_NO="E-8167, Dated: 14th May 2018"
NEXT_PUBLIC_TRUST_PAN="AADTP7440A"
NEXT_PUBLIC_TRUST_ADDRESS="602, Niranka CHS, Ideal Society, Paud Road, Kothrud, Pune - 411038"
NEXT_PUBLIC_TRUST_PHONE="7447794477"
NEXT_PUBLIC_TRUST_EMAIL="puneckpfamily@gmail.com"
# Canonical site URL. Drives canonical tags, sitemap, OG tags and the receipt.
NEXT_PUBLIC_TRUST_WEBSITE="https://puneckptrust.vercel.app"

# --- Two sites, one project ---
# The public website answers on the main domain; the Trust Management System
# answers only on this host (add both domains to the same Vercel project).
# Locally the management system is at http://admin.localhost:3000
NEXT_PUBLIC_ADMIN_HOST=puneckptrust-admin.vercel.app

# --- Demo or live data ---
# demo: the site uses a separate demo database (create it with `npm run demo:create`);
#       nothing done there reaches the real books, and every outgoing e-mail goes to
#       DEMO_MAIL_TO (default: the SMTP_USER mailbox) instead of the member.
# live (or not set): the real database.
DATA_MODE=live
DEMO_DATABASE_NAME=ckp_demo
DEMO_MAIL_TO=

# --- Alpha testing on Vercel's free addresses ---
# Until the real domain is bought the public site is https://puneckptrust.vercel.app and the
# management system https://puneckptrust-admin.vercel.app (both added under the same Vercel
# project). After buying puneckptrust.in: set NEXT_PUBLIC_TRUST_WEBSITE=https://puneckptrust.in,
# NEXT_PUBLIC_ADMIN_HOST=admin.puneckptrust.in, SITE_INDEXING=on, and redeploy.
# off: search engines are asked not to list the temporary address.
SITE_INDEXING=off
# A long random string; lets the daily greetings job run (Vercel sends it automatically).
CRON_SECRET=
